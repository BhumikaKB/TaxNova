# Copy this file to .env (or set these as real environment variables)
# before running TaxNova. Never commit a real .env file.

# A long, random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
TAXNOVA_SECRET_KEY=replace-with-a-real-random-value

# Keep False in production. Debug mode exposes the Werkzeug
# interactive debugger, which allows remote code execution if it's
# ever reachable. Only set to True while developing on localhost.
FLASK_DEBUG=False

# Set to True only once the app is actually served over HTTPS.
# Forces the session cookie to only be sent over encrypted
# connections. Leave False for local development (localhost has no
# TLS), or the login cookie won't be sent and you'll never stay
# logged in.
TAXNOVA_HTTPS=False
